{
    "name": "simple-media-categories",
    "version": "1.3.0",
    "description": "Simple Media Categories WordPress plugin",
    "private": true,
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "lint:js": "wp-scripts lint-js",
        "lint:css": "wp-scripts lint-style",
        "lint:php": "phpcs",
        "test:js": "wp-scripts test-unit-jest",
        "test:php": "wp-env run --env-cwd=wp-content/plugins/simple-media-categories tests-cli vendor/bin/phpunit",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "pot": "wp-env run cli --env-cwd=wp-content/plugins/simple-media-categories wp i18n make-pot . languages/simple-media-categories.pot --domain=simple-media-categories --exclude=vendor,node_modules,build,tests",
        "make-json": "wp-env run cli --env-cwd=wp-content/plugins/simple-media-categories wp i18n make-json languages --no-purge",
        "plugin-zip": "npm run build && wp-scripts plugin-zip"
    },
    "files": [
        "assets/**",
        "build/**",
        "includes/**",
        "languages/**",
        "lib/**",
        "simple-media-categories.php",
        "uninstall.php",
        "readme.txt"
    ],
    "devDependencies": {
        "@babel/core": "^7.25.7",
        "@testing-library/react": "^16.3.2",
        "@wordpress/api-fetch": "^7.49.0",
        "@wordpress/babel-preset-default": "^8.55.0",
        "@wordpress/components": "^36.0.0",
        "@wordpress/compose": "^8.2.0",
        "@wordpress/data": "^10.49.0",
        "@wordpress/element": "^8.1.0",
        "@wordpress/env": "^12.1.0",
        "@wordpress/i18n": "^6.22.0",
        "@wordpress/jest-preset-default": "^14.2.0",
        "@wordpress/notices": "^5.49.0",
        "@wordpress/scripts": "^37.1.0",
        "@wordpress/url": "^4.49.0",
        "babel-jest": "^30.5.0",
        "eslint-plugin-jest": "^29.17.0",
        "jest": "^30.5.0",
        "jest-environment-jsdom": "^30.5.0"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1"
    }
}
