{
    "name": "simple-media-categories",
    "version": "1.0.0",
    "description": "Simple Media Categories WordPress plugin",
    "private": true,
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "lint:js": "wp-scripts lint-js",
        "lint:css": "wp-scripts lint-style",
        "lint:php": "phpcs",
        "test:js": "wp-scripts test-unit-js",
        "test:php": "wp-env run --env-cwd=wp-content/plugins/simple-media-categories tests-cli vendor/bin/phpunit",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "plugin-zip": "npm run build && wp-scripts plugin-zip"
    },
    "files": [
        "assets/**",
        "build/**",
        "includes/**",
        "simple-media-categories.php",
        "readme.txt"
    ],
    "devDependencies": {
        "@wordpress/api-fetch": "^7.49.0",
        "@wordpress/components": "^36.0.0",
        "@wordpress/compose": "^8.2.0",
        "@wordpress/data": "^10.49.0",
        "@wordpress/element": "^8.1.0",
        "@wordpress/env": "^11.9.0",
        "@wordpress/i18n": "^6.22.0",
        "@wordpress/notices": "^5.49.0",
        "@wordpress/scripts": "^32.5.0",
        "@wordpress/url": "^4.49.0"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1"
    }
